# 로컬 커밋은 승인 없이 허용

prefix_rule(
    pattern = ["git", "add", "commit"],
    decision = "allow",
    justification = "로컬 스테이징 및 커밋은 원격 저장소에 영향을 주지 않으므로 허용합니다.",
)

# 원격 저장소에 푸시하기 전에는 반드시 승인 요청

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "원격 저장소에 변경 사항을 반영하기 전에 사용자 승인이 필요합니다.",
)

# Git 히스토리 변경 작업

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "커밋 히스토리를 다시 작성하기 전에 사용자 승인이 필요합니다.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "병합되지 않은 브랜치를 강제로 삭제할 수 있으므로 승인이 필요합니다.",
)
