# 로컬 커밋은 승인 없이 허용
prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "로컬 커밋은 원격 저장소에 영향을 주지 않으므로 허용합니다.",
)

# 원격 저장소에 푸시하기 전에는 반드시 승인 요청
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "원격 저장소에 변경 사항을 반영하기 전에 사용자 승인이 필요합니다.",
)